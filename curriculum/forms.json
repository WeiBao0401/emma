    { "id": "shelf-shelves", "kind": "plural", "base": "shelf", "form": "shelves", "base_zh": "架子", "source": "kebiao",
      "rule": "shelf 的复数是 shelves：f 变成 v，再加 es。", "ex": "The books are on the shelves.", "ex_zh": "书在书架上。" },
    { "id": "box-boxes", "kind": "plural", "base": "box", "form": "boxes", "base_zh": "盒子", "source": "rule",
      "rule": "x 结尾的词，复数加 es：box → boxes。", "ex": "Momo likes boxes.", "ex_zh": "Momo 喜欢盒子。" },
    { "id": "bus-buses", "kind": "plural", "base": "bus", "form": "buses", "base_zh": "公共汽车", "source": "rule",
