    { "id": "city-cities", "kind": "plural", "base": "city", "form": "cities", "base_zh": "城市", "source": "rule",
      "rule": "辅音字母加 y 结尾：去掉 y，加 ies。city → cities。", "ex": "There are many big cities in China.", "ex_zh": "中国有很多大城市。" },
    { "id": "party-parties", "kind": "plural", "base": "party", "form": "parties", "base_zh": "聚会", "source": "rule",
