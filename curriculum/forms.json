    { "id": "woman-women", "kind": "plural", "base": "woman", "form": "women", "base_zh": "女人", "source": "kebiao",
      "rule": "woman 的复数是 women：a 变成 e。", "ex": "The women in the photo are teachers.", "ex_zh": "照片里的女士们是老师。" },
    { "id": "foot-feet", "kind": "plural", "base": "foot", "form": "feet", "base_zh": "脚", "source": "kebiao",
      "rule": "foot 的复数是 feet：oo 变成 ee。", "ex": "Snowy has four white feet.", "ex_zh": "Snowy 的四只脚都是白的。" },
    { "id": "mouse-mice", "kind": "plural", "base": "mouse", "form": "mice", "base_zh": "老鼠", "source": "kebiao",
      "rule": "mouse 的复数是 mice，样子全变了。", "ex": "Momo can see two mice.", "ex_zh": "Momo 能看见两只老鼠。" },
    { "id": "leaf-leaves", "kind": "plural", "base": "leaf", "form": "leaves", "base_zh": "叶子", "source": "kebiao",
