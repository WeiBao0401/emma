{
  "version": 1,
  "about": "变形配对（design/teacher-next.md 第 5 节）：原形和变形连线或四选一。不规则的变形取自课标详表（standard-words.json / kebiao.json 的 forms，source 'kebiao'）；名词复数和三单里拼法要变的（加 es、y 变 ies）按规则写（source 'rule'）。原形都是小学 505 或 Starter 到 Unit 3 的词，只出她学过的；例句只用她认识的词，多放猫和故事里的人物。过去分词（seen、gone）不出。",
  "kinds": {
    "plural": { "zh": "复数", "say": "不止一个", "hint": "要找它的复数：不止一个的时候怎么说。" },
    "third": { "zh": "三单", "say": "he、she、it 后面用", "hint": "要找它的三单：主语是 he、she、it（一个人、一只猫）时用的那个。" },
    "past": { "zh": "过去式", "say": "说已经发生的事", "hint": "要找它的过去式：说已经发生的事时用的那个。" }
  },
  "pairs": [
    { "id": "child-children", "kind": "plural", "base": "child", "form": "children", "base_zh": "孩子", "source": "kebiao",
      "rule": "child 的复数不加 s，变成 children。", "ex": "The children are in the park.", "ex_zh": "孩子们在公园里。" },
    { "id": "man-men", "kind": "plural", "base": "man", "form": "men", "base_zh": "男人", "source": "kebiao",
