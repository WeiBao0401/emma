    { "id": "class-classes", "kind": "plural", "base": "class", "form": "classes", "base_zh": "课；班级", "source": "rule",
      "rule": "ss 结尾的词，复数加 es：class → classes。", "ex": "We have six classes today.", "ex_zh": "我们今天有六节课。" },
    { "id": "dress-dresses", "kind": "plural", "base": "dress", "form": "dresses", "base_zh": "连衣裙", "source": "rule",
      "rule": "ss 结尾的词，复数加 es：dress → dresses。", "ex": "Lucy has two red dresses.", "ex_zh": "Lucy 有两条红色的连衣裙。" },
    { "id": "glass-glasses", "kind": "plural", "base": "glass", "form": "glasses", "base_zh": "玻璃杯", "source": "rule",
