    { "id": "library-libraries", "kind": "plural", "base": "library", "form": "libraries", "base_zh": "图书馆", "source": "rule",
      "rule": "辅音字母加 y 结尾：去掉 y，加 ies。library → libraries。", "ex": "Our city has two libraries.", "ex_zh": "我们的城市有两个图书馆。" },

    { "id": "have-has", "kind": "third", "base": "have", "form": "has", "base_zh": "有", "source": "kebiao",
      "rule": "主语是 he、she、it（一个人、一只猫）时，have 变成 has。", "ex": "Mia has a grey cat.", "ex_zh": "Mia 有一只灰色的猫。" },
    { "id": "do-does", "kind": "third", "base": "do", "form": "does", "base_zh": "做", "source": "rule",
