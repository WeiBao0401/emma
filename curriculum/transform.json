{
  "version": 1,
  "source": "句型转换（teacher-next 4.2）：原创句子，只用小学 505 词、课标另列的词和 Starter 到 Unit 3 的词（tests/order.test.mjs 逐词核对，词块和干扰块也查）。给一句陈述句，用词块拼成一般疑问句、否定句、对划线部分提问、主语换成第三人称单数。answer 是正确的词块顺序，also 是另外也对的整句（词块），extra 是干扰块（is 和 are、do 和 does 都给）。who 是新句子的主语，verb 是动词原形，mark 是划线部分，was 是原来的主语，traps 是某个干扰块被用上时老师说的话。op 决定讲哪条规则：be、there、can、do。",
  "kinds": {
    "yn_q": {
      "name": "一般疑问句",
      "task": "变成一般疑问句",
      "frame": "Is / Are / Can / Does + 谁 + ……？",
      "rules": {
        "be": "问句把 is / are 放到最前面，后面再说“谁”，句末用问号。",
        "there": "问“有没有”：把 is / are 放到 there 前面，Is there…？Are there…？",
        "can": "问句把 can 放到最前面，后面的动词不变，还是原形。",
        "do": "句子的动词是 like、have 这样的词，问句借 Do / Does 放在最前面：he / she / it 和一个人用 Does，后面的动词用原形。"
      }
    },
    "neg": {
      "name": "否定句",
      "task": "变成否定句",
      "frame": "谁 + isn't / aren't / can't / doesn't + ……",
      "rules": {
        "be": "否定句在 am / is / are 后面加 not；is not 可以缩成 isn't，are not 缩成 aren't。",
        "there": "there be 的否定也在 is / are 后面加 not：There isn't…，There aren't…。",
        "can": "否定句在 can 后面加 not，写成 can't；后面的动词用原形。",
        "do": "说“不做”，动词前面加 don't；he / she / it 和一个人用 doesn't，后面的动词用原形。"
      }
    },
    "wh_q": {
      "name": "特殊疑问句",
      "task": "对划线部分提问",
      "frame": "问词 + is / does + 谁 + ……？",
      "rules": {
        "be": "划线的部分就是要问的：先放问词，后面接 is / are，再说“谁”。划线部分不要了。",
        "there": "问“有几个”：How many + 名词复数 + are there + 地点？划线的数字不要了。",
        "do": "划线的部分就是要问的：先放问词，后面接 does / do，再说“谁”，动词用原形。划线部分不要了。"
      }
    },
    "third": {
      "name": "主语换成三单",
      "task": "换主语",
      "frame": "he / she / 一个人 + 动词加 -s + ……",
      "rules": {
        "be": "主语换成一个人（he / she / it 这一类），am / are 要换成 is。",
        "do": "主语换成一个人（he / she / it 这一类），动词要加 -s：like 变成 likes，go 变成 goes，have 变成 has。",
        "can": "can 不跟着主语变，后面的动词也不加 -s。"
      }
    }
  },
  "tags": {},
  "items": [
