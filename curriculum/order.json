    { "id": "pt1", "pattern": "place_time", "en": "We have lunch at school.", "zh": "我们在学校吃午饭。", "tiles": ["we", "have", "lunch", "at school"] },
    { "id": "pt2", "pattern": "place_time", "en": "Mia gets home at six.", "zh": "Mia 六点到家。", "tiles": ["Mia", "gets", "home", "at six"], "alts": [[3, 0, 1, 2]], "from": "ep3" },
    { "id": "pt3", "pattern": "place_time", "en": "I read books at home in the evening.", "zh": "我晚上在家看书。", "tiles": ["I", "read", "books", "at home", "in the evening"], "alts": [[4, 0, 1, 2, 3]],
