{
  "version": 1,
  "source": "连词成句（Wei 10-24 定的第 2 批第 6 项）：原创句子，只用小学 505 词、课标另列的词和 Starter 到 Unit 3 的词（tests/order.test.mjs 逐词核对）。句子按语法卡分组，一部分取自期中番外（Mia、Momo 这些名字她能换）。tiles 按正确顺序写，界面打乱；alts 是另外也对的顺序（tiles 的下标）。",
  "patterns": {
    "be": { "name": "be 动词句", "card": "be_verb", "point": "g:be", "tag": "word_order",
      "rule": "先说“谁”，再放 am / is / are，最后说“什么样”或“在哪儿”。", "frame": "谁 + am / is / are + 什么样 / 在哪儿", "first": "英语句子先说“谁”。" },
    "be_not": { "name": "be 动词的否定", "card": "be_verb", "point": "g:be", "tag": "not_order",
      "rule": "not 跟在 am / is / are 的后面：I am not…，It is not…。", "frame": "谁 + am / is / are + not + ……", "first": "先说“谁”，not 留到 am / is / are 后面。" },
    "be_q": { "name": "be 动词的问句", "card": "be_verb", "point": "g:be", "tag": "q_order",
      "rule": "问“是不是”“在不在”：把 Is / Are 放到最前面，后面再说“谁”，句子最后是问号。", "frame": "Is / Are + 谁 + ……？", "first": "问句先放 Is 或 Are。" },
    "there_be": { "name": "there be 句", "card": "there_be", "point": "g:there_be", "tag": "there_order",
      "rule": "说“某个地方有什么”：用 There is / There are 开头，接着说有什么，地点放在最后。", "frame": "There is / There are + 什么 + 在哪儿", "first": "“有”用 There 开头。" },
    "there_q": { "name": "there be 的问句", "card": "there_be", "point": "g:there_be", "tag": "q_order",
      "rule": "问“有没有”：把 Is / Are 放到 there 前面，Is there…？Are there…？", "frame": "Is / Are + there + 什么 + 在哪儿？", "first": "问“有没有”，先放 Is 或 Are。" },
    "how_many": { "name": "How many 问句", "card": "there_be", "point": "g:how_many_much", "tag": "wh_order",
      "rule": "问“有多少”：How many 后面紧跟名词复数，再接 are there，地点放最后。", "frame": "How many + 名词复数 + are there + 在哪儿？", "first": "问“多少”，先放 How many。" },
    "poss_s": { "name": "名词所有格 's", "card": "possessive_s", "point": "g:possessive_s", "tag": "word_order",
      "rule": "说“谁的东西”：先说谁，加 's，后面紧跟东西：Tom's phone（Tom 的手机）。", "frame": "谁's + 东西", "first": "先找出这句说的是什么。" },
    "mine": { "name": "物主代词", "card": "pronoun", "point": "g:possessive_pronoun", "tag": "word_order",
      "rule": "my、your、her 后面一定跟着东西（my bag）；mine、yours 后面什么都不跟，常放在句子最后（It is mine.）。", "frame": "my + 东西 / ……is mine", "first": "先找出这句说的是什么。" },
    "sv": { "name": "一般现在时的句子", "card": "present_simple", "point": "g:present_simple", "tag": "word_order",
      "rule": "先说“谁”，再说“做什么”，再说做的东西；地点、时间放在后面。he、she、it 和一个人的名字后面，动词加 -s。", "frame": "谁 + 做什么 + 什么 + 地点 / 时间", "first": "英语句子先说“谁”。" },
    "dont": { "name": "don't / doesn't", "card": "present_simple", "point": "g:do_does_q", "tag": "not_order",
      "rule": "说“不做”：don't / doesn't 放在动词前面，后面的动词用原形（doesn't like，不说 doesn't likes）。", "frame": "谁 + don't / doesn't + 动词原形 + ……", "first": "先说“谁”，再放 don't 或 doesn't。" },
    "do_q": { "name": "Do / Does 问句", "card": "present_simple", "point": "g:do_does_q", "tag": "q_order",
      "rule": "问“做不做”：Do / Does 放最前面，再说“谁”，再说动词原形。", "frame": "Do / Does + 谁 + 动词原形 + ……？", "first": "问“做不做”，先放 Do 或 Does。" },
    "wh_q": { "name": "特殊疑问句", "card": "be_verb", "point": "g:be", "tag": "wh_order",
      "rule": "what、where 这类问词放在最前面，后面紧跟 is / are 或 do / does，再说“谁”。", "frame": "问词 + is / do / does + 谁 + ……？", "first": "这类问句先放问词。" },
    "can": { "name": "can 的句子", "card": "can", "point": "g:can", "tag": "word_order",
      "rule": "can 放在动词前面，后面的动词用原形：Lucy can swim。“不能”是 can't。", "frame": "谁 + can / can't + 动词原形 + ……", "first": "先说“谁”，再放 can。" },
    "can_q": { "name": "can 的问句", "card": "can", "point": "g:can", "tag": "q_order",
      "rule": "问“会不会”“能不能”：Can 放最前面，再说“谁”，再说动词原形。", "frame": "Can + 谁 + 动词原形 + ……？", "first": "问“能不能”，先放 Can。" },
    "adj": { "name": "形容词放在哪", "card": null, "point": "", "tag": "adj_order",
      "rule": "形容词放在名词前面：a white cat。两个形容词时，大小、新旧在前，颜色在后：a small white cat。", "frame": "a + 形容词 + 名词", "first": "英语句子先说“谁”。" },
    "place_time": { "name": "地点和时间", "card": null, "point": "", "tag": "place_time",
      "rule": "地点和时间一般放在句子后面；两个都有时，先说地点，再说时间。", "frame": "谁 + 做什么 + 地点 + 时间", "first": "英语句子先说“谁”。" },
    "freq": { "name": "频度副词放在哪", "card": "freq_adverb", "point": "g:freq_adverb", "tag": "adv_position",
      "rule": "always、often、sometimes、never 放在动词前面；遇到 am / is / are，放在它们后面。", "frame": "谁 + often + 动词 / 谁 + is + always + ……", "first": "英语句子先说“谁”。" }
  },
  "items": [
    { "id": "be1", "pattern": "be", "en": "My cat is grey.", "zh": "我的猫是灰色的。", "tiles": ["my", "cat", "is", "grey"] },
    { "id": "be2", "pattern": "be", "en": "The books are on the desk.", "zh": "书在书桌上。", "tiles": ["the books", "are", "on", "the desk"] },
    { "id": "be3", "pattern": "be", "en": "Lucy and I are good friends.", "zh": "Lucy 和我是好朋友。", "tiles": ["Lucy", "and", "I", "are", "good", "friends"],
      "why": "说“我和别人”时，英语把 I 放在后面：Lucy and I。" },
    { "id": "be4", "pattern": "be", "en": "Ms Wang is our teacher.", "zh": "王老师是我们的老师。", "tiles": ["Ms Wang", "is", "our", "teacher"], "alts": [[2, 3, 1, 0]] },

    { "id": "nt1", "pattern": "be_not", "en": "I am not tired.", "zh": "我不累。", "tiles": ["I", "am", "not", "tired"] },
    { "id": "nt2", "pattern": "be_not", "en": "Momo is not in the box.", "zh": "Momo 不在箱子里。", "tiles": ["Momo", "is", "not", "in", "the box"] },
    { "id": "nt3", "pattern": "be_not", "en": "They are not my socks.", "zh": "它们不是我的袜子。", "tiles": ["they", "are", "not", "my", "socks"] },

    { "id": "bq1", "pattern": "be_q", "en": "Is this your bag?", "zh": "这是你的书包吗？", "tiles": ["is", "this", "your", "bag"] },
    { "id": "bq2", "pattern": "be_q", "en": "Are you ready?", "zh": "你准备好了吗？", "tiles": ["are", "you", "ready"] },
    { "id": "bq3", "pattern": "be_q", "en": "Is Momo under the bed?", "zh": "Momo 在床底下吗？", "tiles": ["is", "Momo", "under", "the bed"] },
    { "id": "bq4", "pattern": "be_q", "en": "Are they your friends?", "zh": "他们是你的朋友吗？", "tiles": ["are", "they", "your", "friends"] },

    { "id": "tb1", "pattern": "there_be", "en": "There is a box under the tree.", "zh": "树下有一个箱子。", "tiles": ["there", "is", "a box", "under", "the tree"], "alts": [[3, 4, 0, 1, 2]], "from": "ep4" },
    { "id": "tb2", "pattern": "there_be", "en": "There are two cats in the garden.", "zh": "院子里有两只猫。", "tiles": ["there", "are", "two cats", "in", "the garden"], "alts": [[3, 4, 0, 1, 2]],
      "why": "两只猫是复数，所以用 There are。" },
    { "id": "tb3", "pattern": "there_be", "en": "There is some milk in the cup.", "zh": "杯子里有一些牛奶。", "tiles": ["there", "is", "some", "milk", "in", "the cup"], "alts": [[4, 5, 0, 1, 2, 3]],
      "why": "milk 不能数，用 There is。" },
    { "id": "tb4", "pattern": "there_be", "en": "There are many books in our classroom.", "zh": "我们教室里有很多书。", "tiles": ["there", "are", "many", "books", "in", "our classroom"], "alts": [[4, 5, 0, 1, 2, 3]] },

    { "id": "tq1", "pattern": "there_q", "en": "Is there a cat in the box?", "zh": "箱子里有一只猫吗？", "tiles": ["is", "there", "a cat", "in", "the box"] },
    { "id": "tq2", "pattern": "there_q", "en": "Are there any apples on the table?", "zh": "桌子上有苹果吗？", "tiles": ["are", "there", "any", "apples", "on", "the table"],
      "why": "问句里“一些”用 any。" },
    { "id": "tq3", "pattern": "there_q", "en": "Is there a park near your home?", "zh": "你家附近有公园吗？", "tiles": ["is", "there", "a park", "near", "your home"] },

    { "id": "hm1", "pattern": "how_many", "en": "How many students are there in your class?", "zh": "你们班有多少个学生？", "tiles": ["how many", "students", "are", "there", "in", "your class"] },
    { "id": "hm2", "pattern": "how_many", "en": "How many cats are there in the picture?", "zh": "图片里有几只猫？", "tiles": ["how many", "cats", "are", "there", "in", "the picture"] },
    { "id": "hm3", "pattern": "how_many", "en": "How many books are there on the desk?", "zh": "书桌上有几本书？", "tiles": ["how many", "books", "are", "there", "on", "the desk"] },

    { "id": "ps1", "pattern": "poss_s", "en": "This is Tom's phone.", "zh": "这是 Tom 的手机。", "tiles": ["this", "is", "Tom's", "phone"] },
    { "id": "ps2", "pattern": "poss_s", "en": "Lucy's eyes are blue.", "zh": "Lucy 的眼睛是蓝色的。", "tiles": ["Lucy's", "eyes", "are", "blue"] },
    { "id": "ps3", "pattern": "poss_s", "en": "Grandma Li's garden is very big.", "zh": "李奶奶家的院子很大。", "tiles": ["Grandma Li's", "garden", "is", "very", "big"], "from": "ep4" },
    { "id": "ps4", "pattern": "poss_s", "en": "The cat's name is Momo.", "zh": "这只猫的名字叫 Momo。", "tiles": ["the cat's", "name", "is", "Momo"], "alts": [[3, 2, 0, 1]] },

    { "id": "mn1", "pattern": "mine", "en": "This is her red scarf.", "zh": "这是她的红领巾。", "tiles": ["this", "is", "her", "red", "scarf"], "from": "ep1" },
