    { "id": "mn3", "pattern": "mine", "en": "Is this cat yours?", "zh": "这只猫是你的吗？", "tiles": ["is", "this", "cat", "yours"], "from": "ep4",
      "why": "这是问句，Is 放最前面；yours 放在最后。" },

    { "id": "sv1", "pattern": "sv", "en": "Mia likes cats very much.", "zh": "Mia 非常喜欢猫。", "tiles": ["Mia", "likes", "cats", "very much"],
