    { "id": "cq3", "pattern": "can_q", "en": "Can Tom draw cats?", "zh": "Tom 会画猫吗？", "tiles": ["can", "Tom", "draw", "cats"] },

    { "id": "aj1", "pattern": "adj", "en": "It is a small white cat.", "zh": "那是一只白色的小猫。", "tiles": ["it", "is", "a", "small", "white", "cat"],
      "why": "先说大小（small），再说颜色（white），最后是 cat。" },
    { "id": "aj2", "pattern": "adj", "en": "I have a new blue bag.", "zh": "我有一个新的蓝色书包。", "tiles": ["I", "have", "a", "new", "blue", "bag"],
