    { "id": "dn3", "pattern": "dont", "en": "We don't have English on Friday.", "zh": "我们星期五没有英语课。", "tiles": ["we", "don't", "have", "English", "on Friday"], "alts": [[4, 0, 1, 2, 3]] },
    { "id": "dn4", "pattern": "dont", "en": "Lucy doesn't watch TV at night.", "zh": "Lucy 晚上不看电视。", "tiles": ["Lucy", "doesn't", "watch", "TV", "at night"], "alts": [[4, 0, 1, 2, 3]] },

    { "id": "dq1", "pattern": "do_q", "en": "Do you like cats?", "zh": "你喜欢猫吗？", "tiles": ["do", "you", "like", "cats"] },
    { "id": "dq2", "pattern": "do_q", "en": "Does Tom have a phone?", "zh": "Tom 有手机吗？", "tiles": ["does", "Tom", "have", "a phone"],
