    { "id": "fq3", "pattern": "freq", "en": "Tom sometimes forgets his pen.", "zh": "Tom 有时候忘带笔。", "tiles": ["Tom", "sometimes", "forgets", "his pen"], "alts": [[1, 0, 2, 3]] },
    { "id": "fq4", "pattern": "freq", "en": "I never eat fish.", "zh": "我从来不吃鱼。", "tiles": ["I", "never", "eat", "fish"] }
