    { "id": "dq3", "pattern": "do_q", "en": "Does your cat sleep on the bed?", "zh": "你的猫睡在床上吗？", "tiles": ["does", "your", "cat", "sleep", "on", "the bed"] },
    { "id": "dq4", "pattern": "do_q", "en": "Do they go to school by bus?", "zh": "他们坐公共汽车上学吗？", "tiles": ["do", "they", "go", "to school", "by bus"] },

    { "id": "wh1", "pattern": "wh_q", "en": "Where is my red scarf?", "zh": "我的红领巾在哪儿？", "tiles": ["where", "is", "my", "red scarf"], "from": "ep1" },
    { "id": "wh2", "pattern": "wh_q", "en": "What is in the box?", "zh": "箱子里有什么？", "tiles": ["what", "is", "in", "the box"] },
