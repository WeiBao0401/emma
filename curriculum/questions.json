{
  "version": 1,
  "source": "英语小对话的按钮问题（DESIGN 2.5、3.5；teacher-memory 7.2）。和句库是同一套，Claude 预写，家长过目。老师用英文问，按钮也是英文，每句下面带中文字幕；只给按钮，不开输入框；按哪个都算答了，不打分。",
  "rules": {
    "week1": "第一周每天收尾最多一个（day 1-5），能跳过，不叫问卷",
    "weekly": "第 2 周起每周最多一个（lines.weeklyQuestion 挑：这周还没问过、先挑没问过的、week. 开头的“这周”问题优先）；周反思上线后由它按 id 挑（ask_emma 只返回 qid）",
    "answer": "回答记 events { type: 'ask', qid, who: 'emma', answer: 选项 id, about }；跳过记 answer: 'skip'",
    "requires": "题或选项的 requires：要这些功能上线才出（story 故事、grammar 语法卡、listen 听音选词、tiles 字母块、dictation 这周写过听写）；剩下的选项不到 2 个，这题这次不问",
    "options_from": "选项由调用方现给：source words 是这周的词 [{ slug, w, cn }]，episodes 是这周的集 [{ id, en, zh }]；选项 id 是 w:<slug> / ep:<id>，about 是 <about>:<slug>；不到 min 个就不问"
  },
  "buttons": {
    "none": {
      "id": "none",
      "en": "Not these",
      "zh": "都不是",
      "about": null
    },
    "skip": {
      "id": "skip",
      "en": "Not now",
      "zh": "先跳过",
      "about": null
    }
  },
